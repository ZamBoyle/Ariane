# Node 22.14 is a floor, not a preference: below it better-sqlite3 segfaults on
# the first query instead of failing. Refuse the install rather than warn.
engine-strict=true

# Nothing here needs building. better-sqlite3 ships one Node-API binary per
# system inside its own package, but it also ships a binding.gyp — and npm runs
# an implicit `node-gyp rebuild` for any package that has one. On Linux that
# wants python3 and make to build nothing; on Windows it fails outright for want
# of a Python it cannot run, and takes `npm install` down with it. The only
# other install script in the tree is electron-winstaller's, for Squirrel, which
# these packages do not use. Electron declares no script at all: it fetches its
# binary on first use.
ignore-scripts=true
